# ── Required ──────────────────────────────────────────────────────────────
# 1. Create a bot with @BotFather on Telegram and paste its token:
TELEGRAM_BOT_TOKEN=
# 2. Your Telegram user ID(s), comma-separated. Leave empty, message the bot once,
#    and it will tell you your ID. Keeps strangers from spending your API credits.
ALLOWED_USER_IDS=

# 3. Bring your own LLM: "<provider>:<model>" + that provider's key.
LLM_MODEL=openai:gpt-4o-mini
OPENAI_API_KEY=
# LLM_MODEL=anthropic:claude-haiku-4-5       + ANTHROPIC_API_KEY=
# LLM_MODEL=google_genai:gemini-2.5-flash    + GOOGLE_API_KEY=
# LLM_MODEL=groq:llama-3.3-70b-versatile     + GROQ_API_KEY=
# LLM_MODEL=ollama:llama3.1                  (local & free, no key; set OLLAMA_BASE_URL if remote)

# ── Optional ──────────────────────────────────────────────────────────────
# Free key (instant): https://fdc.nal.usda.gov/api-key-signup — DEMO_KEY is heavily rate limited.
USDA_API_KEY=DEMO_KEY
USE_OPEN_FOOD_FACTS=true
DEFAULT_TIMEZONE=UTC
# Default: SQLite file in ./data. For Postgres: postgresql+psycopg://user:pass@host/db
# DATABASE_URL=sqlite:///data/calorie_agent.db
WEEKLY_REPORT_WEEKDAY=6   # 0=Mon … 6=Sun (user's local time)
WEEKLY_REPORT_HOUR=20
